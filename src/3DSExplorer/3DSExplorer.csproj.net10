<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>_3DSExplorer</RootNamespace>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;CA2022</NoWarn>
  </PropertyGroup>
  <!-- <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup> -->
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.2.1" />

    <PackageReference Include="SharpCompress" Version="0.42.1" />
    <PackageReference Include="SharpGL" Version="3.1.1" />
    <PackageReference Include="SharpGL.WinForms" Version="3.1.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- If you use System.Drawing with ZXing, add: -->
    <!-- <PackageReference Include="ZXing.Windows.Compatibility" Version="0.16.14" /> -->
  </ItemGroup>
</Project>